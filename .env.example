# OpenLab-Scale Environment Configuration
# ==============================================================================

# License Manager Configuration
MAX_SEATS=100
LEASE_TTL_SEC=60
HEARTBEAT_INTERVAL_SEC=15
ALLOCATION_POLICY=baseline
LICENSE_MANAGER_PORT=8000

# eBPF Agent Configuration
# Options: auto | enabled | fallback
EBPF_MODE=auto

# Redis State Store Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Mock Workload Simulator Configuration (compose profile: workload)
HOLD_TIME_SEC=30

# Logging & Observability
LOG_LEVEL=INFO
